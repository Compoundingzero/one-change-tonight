---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import MedicalBoundary from '@/components/safety/MedicalBoundary.astro';
import ReviewStatus from './ReviewStatus.astro';
import SourceList from './SourceList.astro';
import ClaimEvidence from './ClaimEvidence.astro';

interface Link {
  label: string;
  href: string;
}
interface Props {
  article: {
    path: string;
    title: string;
    description: string;
    eyebrow: string;
    audience: string;
    directAnswer: string;
    uncertainty: string;
    applies: string[];
    mayNotApply: string[];
    observations: string[];
    experimentName: string;
    experimentChange: string;
    experimentConstant: string;
    experimentSteps: string[];
    doNotBuy: string;
    safetyNote: string;
    sourceIds: string[];
    broaderLink: Link;
    nextLink: Link;
    context: string;
    published: string;
    reviewed: string;
    indexable: boolean;
  };
}
const { article } = Astro.props;
const contextHref = `/tool/#${article.context}`;
const isProductDecision =
  article.path.startsWith('/compare/') || article.context === 'mechanisms';
const isCareGuide = article.context === 'care-notes';
const nonPhysicalActionPaths = new Set([
  '/compare/air-vs-water-bed-cooling/',
  '/compare/bed-fan-vs-water-pad/',
  '/compare/first-touch-vs-all-night-cooling/',
  '/compare/one-zone-vs-dual-zone/',
  '/failed-fixes/cooling-sheets-not-working/',
  '/guides/bed-cooling-costs-and-maintenance/',
  '/why/hot-while-partner-is-cold/',
  '/why/night-sweats-or-overheating/',
  '/why/thermostat-not-helping/',
  '/why/waking-sweaty-in-a-cold-room/',
]);
const actionNeedsStop = !isCareGuide && !nonPhysicalActionPaths.has(article.path);
const isObservationOnly = !isProductDecision && nonPhysicalActionPaths.has(article.path);
const showToolInvite =
  article.path.startsWith('/why/') || article.path.startsWith('/failed-fixes/');
const spendingHeading = isCareGuide
  ? article.path === '/guides/when-to-seek-medical-advice/'
    ? 'Care comes before cooling products'
    : 'Skip special tracking gear'
  : isProductDecision
    ? 'Before you compare products'
    : article.path.startsWith('/failed-fixes/')
      ? 'Before trying another product'
      : 'Before buying a fix';
---

<BaseLayout
  title={article.title}
  description={article.description}
  article
  noindex={!article.indexable}
  published={article.published}
  modified={article.reviewed}
>
  <article class="wrap article-shell">
    <header class="article-head">
      <p class="eyebrow">{article.eyebrow}</p>
      <h1>{article.title}</h1>
      <ReviewStatus published={article.published} reviewed={article.reviewed} />
    </header>

    <section id="direct-answer" class="direct panel">
      <h2>Short answer</h2>
      <p>{article.directAnswer}</p>
      <p class="audience"><strong>Who this is for:</strong> {article.audience}</p>
      <h3>When this applies</h3>
      <ul>{article.applies.map((item) => <li>{item}</li>)}</ul>
      <p class="answer-limit"><strong>What we don’t know:</strong> {article.uncertainty}</p>
    </section>

    <MedicalBoundary compact />

    <section id="what-to-observe">
      <h2>Clues to check</h2>
      <ul>{article.observations.map((item) => <li>{item}</li>)}</ul>
      {
        article.mayNotApply.length > 0 && (
          <div class="may-not-fit">
            <h3>This page may not fit if</h3>
            <ul>
              {article.mayNotApply.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        )
      }
    </section>

    <section id="one-change-tonight" class="experiment panel">
      <p class="eyebrow">
        {
          isCareGuide
            ? 'For a healthcare conversation'
            : isProductDecision
              ? 'First step'
              : isObservationOnly
                ? 'One thing to observe'
                : 'One Change Tonight'
        }
      </p>
      <h2>{article.experimentName}</h2>
      <p>
        <strong>
          {
            isProductDecision || isCareGuide
              ? 'Next step'
              : isObservationOnly
                ? 'Observe'
                : 'Change only'
          }:
        </strong>{' '}
        {article.experimentChange}
      </p>
      <p id="what-to-keep-the-same">
        <strong>Keep the same:</strong>{' '}
        {article.experimentConstant}
      </p>
      <ol>{article.experimentSteps.map((step) => <li>{step}</li>)}</ol>
      {
        actionNeedsStop && (
          <>
            <p>
              <strong>In the morning:</strong> record awakenings, dampness, cold afterward, time
              to become comfortable, partner disturbance, and whether this one change helped.
            </p>
            <p>
              <strong>Stop:</strong> if the change causes discomfort, breathing irritation,
              unsafe cold, or disturbs either sleeper more than it helps.
            </p>
          </>
        )
      }
      <p class="safety-note">{article.safetyNote}</p>
    </section>

    <section id="do-not-buy-yet" class="dont-buy">
      <h2>{spendingHeading}</h2>
      <p>{article.doNotBuy}</p>
    </section>

    {
      showToolInvite && (
        <aside class="tool-invite panel" aria-labelledby="tool-invite-title">
          <h2 id="tool-invite-title">Not sure what to test?</h2>
          <p>
            Answer questions about the room, bed, timing, and moisture. No account or name; your
            answers stay in this browser.
          </p>
          <a class="button" href={contextHref}>
            Start the private check
          </a>
        </aside>
      )
    }

    <nav class="next-questions" aria-label="Related reading">
      <h2>Related guides</h2>
      <a href={article.broaderLink.href}>{article.broaderLink.label}</a>
      <a href={article.nextLink.href}>{article.nextLink.label}</a>
    </nav>

    <ClaimEvidence route={article.path} compact />
    <SourceList ids={article.sourceIds} compact />
  </article>
</BaseLayout>
<style>
  .article-shell {
    max-width: 66rem;
    padding-top: clamp(2rem, 6vw, 5rem);
  }
  .article-head {
    max-width: 52rem;
    margin-bottom: var(--space-6);
  }
  .article-head h1 {
    font-size: clamp(2.5rem, 6vw, 4.7rem);
  }
  .direct {
    margin-bottom: var(--space-5);
    border-top: 5px solid var(--cool-600);
  }
  .direct p {
    margin: 0;
    font-size: 1.08rem;
  }
  .direct h2 {
    margin: 0 0 0.75rem;
    font-size: 1.15rem;
  }
  .direct h3 {
    margin-bottom: 0.45rem;
    font-size: 1rem;
  }
  .direct .audience,
  .direct .answer-limit {
    margin-top: 1rem;
    font-size: 0.96rem;
  }
  .experiment h2 {
    margin-top: 0.5rem;
  }
  .experiment {
    margin-top: var(--space-7);
    background: linear-gradient(140deg, var(--paper-raised), var(--cool-150));
  }
  .dont-buy {
    border-block: 1px solid var(--line);
    margin-block: var(--space-7);
  }
  .may-not-fit {
    margin-top: var(--space-5);
  }
  .may-not-fit h3 {
    margin-bottom: 0.5rem;
  }
  .tool-invite {
    margin-top: var(--space-7);
  }
  .next-questions {
    display: grid;
    gap: 0.75rem;
    padding-block: var(--space-6);
  }
  .next-questions h2 {
    margin-bottom: 0.25rem;
  }
</style>
