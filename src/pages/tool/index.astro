---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import MedicalBoundary from '@/components/safety/MedicalBoundary.astro';
import AssessmentApp from '@/components/assessment/AssessmentApp';
const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Find tonight’s change',
  applicationCategory: 'LifestyleApplication',
  operatingSystem: 'Any modern web browser',
  description:
    'A private tool that suggests one reversible change to the room or bed. It cannot diagnose a medical condition.',
};
const contextTargets = [
  'partner-temperature',
  'cold-room',
  'hot-then-cold',
  'bed-heat',
  'failed-fix',
  'mechanisms',
  'care-notes',
];
---

<BaseLayout
  title="Find Tonight’s Change"
  description="Answer a few private questions and get one reversible change to try tonight. No diagnosis or account, and your answers are not sent to us."
  jsonLd={appSchema}
>
  <div class="tool-shell wrap">
    <header>
      <p class="eyebrow">Find tonight’s change</p>
      <h1>Choose one thing to change tonight.</h1>
      <p class="lede">
        Answer what happened in the room, bed, and body, and whether another sleeper felt hot or
        cold. You’ll get one change to try and the reason for it.
      </p>
    </header>
    <MedicalBoundary />
    <div class="context-targets" aria-hidden="true">
      {contextTargets.map((target) => <span id={target} />)}
    </div>
    <AssessmentApp client:load />
    <section class="static-explanation">
      <h2>What the tool examines</h2>
      <p>
        Whole-room heat, bed heat build-up, sudden personal heat that the room does not fully
        explain, moisture after sweating, and whether one side of a shared bed needs a different
        environment.
      </p>
      <h2>What it cannot determine</h2>
      <p>
        The result cannot identify menopause, another medical condition, a medicine effect, or
        any underlying cause. A cooler room or bed may affect comfort without treating the
        reason for an episode.
      </p>
      <p>
        <a href="/methodology/">See how the fixed rules work</a> · <a href="/evidence/"
          >Review what the evidence can and cannot show</a
        > · <a href="/sources/">Open the source list</a>
      </p>
    </section>
  </div>
</BaseLayout>
<style>
  .tool-shell {
    padding-top: clamp(2rem, 6vw, 5rem);
  }
  header {
    max-width: 54rem;
    margin-bottom: 1.5rem;
  }
  header h1 {
    font-size: clamp(2.5rem, 6vw, 4.6rem);
  }
  .tool-shell > .notice {
    max-width: 52rem;
    margin: 0 auto 1rem;
  }
  .context-targets {
    height: 0;
    overflow: hidden;
  }
  .static-explanation {
    max-width: 52rem;
    margin: var(--space-8) auto 0;
  }
</style>
